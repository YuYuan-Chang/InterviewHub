generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  userId       String   @id @map("user_id")
  username     String   @unique
  displayName  String   @map("display_name")
  school       String   @default("")
  targetRoles  String[] @map("target_roles")
  bio          String   @default("")
  avatarFileId String?  @map("avatar_file_id") // file-service asset, served via /api/files/:id/content
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("profiles")
}

// The follow graph. Kept in user-service (same aggregate as profiles) but in
// its own module (src/follows/) so it could be extracted into a dedicated
// social-graph service without touching profile code.
model Follow {
  followerId String   @map("follower_id")
  followeeId String   @map("followee_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([followerId, followeeId])
  @@index([followeeId])
  @@map("follows")
}

model Outbox {
  id          String   @id
  payload     Json
  attempts    Int      @default(0)
  availableAt DateTime @default(now()) @map("available_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([availableAt])
  @@map("outbox")
}

model RateLimit {
  key       String   @id
  hits      Int
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("rate_limits")
}
