generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id           String         @id @default(uuid())
  authorId     String         @map("author_id")
  title        String
  description  String
  tags         String[]
  // legacy single-file columns (kept so `db push` stays additive; new posts use `attachments`)
  fileId       String?        @map("file_id")
  fileName     String?        @map("file_name")
  fileMime     String?        @map("file_mime")
  fileSize     Int?           @map("file_size")
  // [{ fileId, name, mime, sizeBytes }, ...] — up to 8 per post
  attachments  Json           @default("[]")
  upvoteCount  Int            @default(0) @map("upvote_count")
  commentCount Int            @default(0) @map("comment_count")
  createdAt    DateTime       @default(now()) @map("created_at")
  reactions    PostReaction[]
  resumeText   String?        @map("resume_text")
  resumeVersion Int           @default(1) @map("resume_version")
  revisions    ResumeRevision[]
  interviewExperience InterviewExperience?

  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@index([upvoteCount(sort: Desc), createdAt(sort: Desc)])
  @@index([tags], type: Gin)
  @@map("posts")
}

model InterviewExperience {
  postId     String @id @map("post_id")
  company    String @db.VarChar(120)
  role       String @db.VarChar(120)
  stage      String
  questions  String
  difficulty String
  outcome    String
  post       Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([company, role])
  @@map("interview_experiences")
}

model PostReaction {
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_reactions")
}

model ResumeRevision {
  id           String   @id @default(uuid())
  postId       String   @map("post_id")
  authorId     String   @map("author_id")
  baseVersion  Int      @map("base_version")
  proposedText String   @map("proposed_text")
  patch        String
  summary      String
  status       String   @default("pending")
  createdAt    DateTime @default(now()) @map("created_at")
  resolvedAt   DateTime? @map("resolved_at")
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("resume_revisions")
}
